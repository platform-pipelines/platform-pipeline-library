{
  "name": "checkout-api",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Node.js API for the platform-pipeline npm path",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "start": "node src/server.js",
    "build": "node --check src/server.js && node --check src/app.js",
    "lint": "eslint . && prettier --check .",
    "test": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
