# Secrets and settings for the local stack. `make local-up` copies this to
# local/.env (gitignored) on first run; fill in what you need and re-run
# `make local-up`. docker compose reads local/.env automatically and
# casc/jenkins.yaml turns each value into a Jenkins credential at startup.
# Anything left empty becomes an empty credential. Shell exports win over this file.

# Jenkins login (user: admin)
JENKINS_ADMIN_PASSWORD=admin

# GitHub — a fine-grained token with Contents, Pull requests and Commit
# statuses (read/write) plus Metadata (read).
#   github-token (secret text)       API steps: statuses, PR comments, GitOps commits
#   github-scm   (username/password) git checkout, multibranch / GitHub Branch Source
GITHUB_USER=
GITHUB_TOKEN=

# SonarQube — generate at http://localhost:9000 > My Account > Security
SONAR_TOKEN=

# Notifications and deploys
SLACK_WEBHOOK=
ARGOCD_TOKEN=

# GitHub Container Registry (artifacts use GITHUB_TOKEN via GitHub releases)
GHCR_USER=
GHCR_TOKEN=

# AWS (terraform / cloudformation / ecs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Keyless image signing (quality.signImage)
COSIGN_OIDC_TOKEN=

# Optional overrides
# LIBRARY_REMOTE=https://github.com/platform-pipelines/platform-pipeline-library.git
# CI_TOOLBOX_IMAGE=ci-toolbox:local
